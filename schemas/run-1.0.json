{
  "$defs": {
    "CompatibilityIssue": {
      "additionalProperties": false,
      "properties": {
        "location": {
          "title": "Location",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "severity": {
          "enum": [
            "warning",
            "unsupported"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "location",
        "severity",
        "reason"
      ],
      "title": "CompatibilityIssue",
      "type": "object"
    },
    "EvaluationResult": {
      "additionalProperties": false,
      "properties": {
        "constraint_violations": {
          "items": {
            "type": "string"
          },
          "title": "Constraint Violations",
          "type": "array"
        },
        "objective_completed": {
          "title": "Objective Completed",
          "type": "boolean"
        },
        "success": {
          "title": "Success",
          "type": "boolean"
        },
        "termination": {
          "title": "Termination",
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/ResourceUsage"
        }
      },
      "required": [
        "success",
        "objective_completed",
        "termination",
        "usage"
      ],
      "title": "EvaluationResult",
      "type": "object"
    },
    "FailureInjection": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "title": "Action",
          "type": "string"
        },
        "kind": {
          "enum": [
            "error_before",
            "response_lost"
          ],
          "title": "Kind",
          "type": "string"
        },
        "occurrence": {
          "default": 1,
          "minimum": 1,
          "title": "Occurrence",
          "type": "integer"
        }
      },
      "required": [
        "action",
        "kind"
      ],
      "title": "FailureInjection",
      "type": "object"
    },
    "JsonValue": {},
    "Origin": {
      "enum": [
        "declared",
        "inferred"
      ],
      "title": "Origin",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "origin",
        "source",
        "reason"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "RefundObjective": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "exclusiveMinimum": 0,
          "title": "Amount",
          "type": "integer"
        },
        "customer_id": {
          "title": "Customer Id",
          "type": "string"
        },
        "duplicate_payment_id": {
          "title": "Duplicate Payment Id",
          "type": "string"
        },
        "kind": {
          "const": "refund_duplicate",
          "default": "refund_duplicate",
          "title": "Kind",
          "type": "string"
        },
        "original_payment_id": {
          "title": "Original Payment Id",
          "type": "string"
        }
      },
      "required": [
        "customer_id",
        "original_payment_id",
        "duplicate_payment_id",
        "amount"
      ],
      "title": "RefundObjective",
      "type": "object"
    },
    "Relationship": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "resource": {
          "title": "Resource",
          "type": "string"
        },
        "target_resource": {
          "title": "Target Resource",
          "type": "string"
        }
      },
      "required": [
        "resource",
        "field",
        "target_resource",
        "provenance"
      ],
      "title": "Relationship",
      "type": "object"
    },
    "ResourceUsage": {
      "additionalProperties": false,
      "properties": {
        "cost_confidence": {
          "anyOf": [
            {
              "const": "ESTIMATED",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Confidence"
        },
        "counter_confidence": {
          "const": "EXACT",
          "default": "EXACT",
          "title": "Counter Confidence",
          "type": "string"
        },
        "elapsed_seconds": {
          "default": 0.0,
          "minimum": 0,
          "title": "Elapsed Seconds",
          "type": "number"
        },
        "estimated_cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Cost Usd"
        },
        "failed_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Failed Calls",
          "type": "integer"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "retries": {
          "default": 0,
          "minimum": 0,
          "title": "Retries",
          "type": "integer"
        },
        "tool_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Tool Calls",
          "type": "integer"
        },
        "world_steps": {
          "default": 0,
          "minimum": 0,
          "title": "World Steps",
          "type": "integer"
        }
      },
      "title": "ResourceUsage",
      "type": "object"
    },
    "Scenario": {
      "additionalProperties": false,
      "properties": {
        "allowed_actions": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Actions",
          "type": "array"
        },
        "failures": {
          "items": {
            "$ref": "#/$defs/FailureInjection"
          },
          "title": "Failures",
          "type": "array"
        },
        "initial_state": {
          "$ref": "#/$defs/WorldState"
        },
        "max_steps": {
          "default": 12,
          "maximum": 1000,
          "minimum": 1,
          "title": "Max Steps",
          "type": "integer"
        },
        "objective": {
          "$ref": "#/$defs/RefundObjective"
        },
        "scenario_id": {
          "title": "Scenario Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "task": {
          "title": "Task",
          "type": "string"
        },
        "visible": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Visible",
          "type": "object"
        },
        "world_id": {
          "title": "World Id",
          "type": "string"
        },
        "world_version": {
          "default": "1",
          "title": "World Version",
          "type": "string"
        }
      },
      "required": [
        "scenario_id",
        "world_id",
        "seed",
        "task",
        "visible",
        "initial_state",
        "objective",
        "allowed_actions"
      ],
      "title": "Scenario",
      "type": "object"
    },
    "WorldAction": {
      "additionalProperties": false,
      "properties": {
        "input_schema": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Input Schema",
          "type": "object"
        },
        "kind": {
          "enum": [
            "create",
            "get",
            "list",
            "refund",
            "unsupported"
          ],
          "title": "Kind",
          "type": "string"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "resource": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource"
        },
        "response_schemas": {
          "additionalProperties": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          "title": "Response Schemas",
          "type": "object"
        },
        "supported": {
          "default": true,
          "title": "Supported",
          "type": "boolean"
        }
      },
      "required": [
        "operation_id",
        "method",
        "path",
        "kind",
        "provenance"
      ],
      "title": "WorldAction",
      "type": "object"
    },
    "WorldDefinition": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "additionalProperties": {
            "$ref": "#/$defs/WorldAction"
          },
          "title": "Actions",
          "type": "object"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/CompatibilityIssue"
          },
          "title": "Issues",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "relationships": {
          "items": {
            "$ref": "#/$defs/Relationship"
          },
          "title": "Relationships",
          "type": "array"
        },
        "resources": {
          "additionalProperties": {
            "$ref": "#/$defs/WorldResource"
          },
          "title": "Resources",
          "type": "object"
        },
        "rules": {
          "items": {
            "type": "string"
          },
          "title": "Rules",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "version": {
          "default": "1",
          "title": "Version",
          "type": "string"
        },
        "world_id": {
          "minLength": 1,
          "title": "World Id",
          "type": "string"
        }
      },
      "required": [
        "world_id",
        "title",
        "resources",
        "actions"
      ],
      "title": "WorldDefinition",
      "type": "object"
    },
    "WorldEvent": {
      "additionalProperties": false,
      "properties": {
        "payload": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Payload",
          "type": "object"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "scenario_id": {
          "title": "Scenario Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "timestamp": {
          "title": "Timestamp",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "world_id": {
          "title": "World Id",
          "type": "string"
        },
        "world_version": {
          "title": "World Version",
          "type": "string"
        }
      },
      "required": [
        "sequence",
        "timestamp",
        "run_id",
        "scenario_id",
        "world_id",
        "world_version",
        "type"
      ],
      "title": "WorldEvent",
      "type": "object"
    },
    "WorldResource": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "schema": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Schema",
          "type": "object"
        }
      },
      "required": [
        "name",
        "schema",
        "provenance"
      ],
      "title": "WorldResource",
      "type": "object"
    },
    "WorldState": {
      "additionalProperties": false,
      "properties": {
        "resources": {
          "additionalProperties": {
            "additionalProperties": {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            "type": "object"
          },
          "title": "Resources",
          "type": "object"
        },
        "step": {
          "default": 0,
          "minimum": 0,
          "title": "Step",
          "type": "integer"
        }
      },
      "title": "WorldState",
      "type": "object"
    }
  },
  "$id": "https://worldforge.local/schemas/run-1.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent_metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Agent Metadata",
      "type": "object"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "evaluation": {
      "$ref": "#/$defs/EvaluationResult"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/WorldEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "final_state": {
      "$ref": "#/$defs/WorldState"
    },
    "run_id": {
      "pattern": "^WF-[0-9a-f]{32}$",
      "title": "Run Id",
      "type": "string"
    },
    "scenario": {
      "$ref": "#/$defs/Scenario"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "world": {
      "$ref": "#/$defs/WorldDefinition"
    }
  },
  "required": [
    "run_id",
    "created_at",
    "world",
    "scenario",
    "agent_metadata",
    "events",
    "final_state",
    "evaluation"
  ],
  "title": "Run",
  "type": "object"
}
