{
  "$defs": {
    "FailureInjection": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "title": "Action",
          "type": "string"
        },
        "kind": {
          "enum": [
            "error_before",
            "response_lost"
          ],
          "title": "Kind",
          "type": "string"
        },
        "occurrence": {
          "default": 1,
          "minimum": 1,
          "title": "Occurrence",
          "type": "integer"
        }
      },
      "required": [
        "action",
        "kind"
      ],
      "title": "FailureInjection",
      "type": "object"
    },
    "FailureSpec": {
      "additionalProperties": false,
      "description": "Versioned deterministic synthetic fault; latency is virtual, never a sleep.",
      "properties": {
        "action": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "kind": {
          "enum": [
            "error_before",
            "response_lost",
            "delay",
            "timeout",
            "permission_denied",
            "rate_limit",
            "service_unavailable",
            "malformed_response",
            "stale_read",
            "duplicate_delivery"
          ],
          "title": "Kind",
          "type": "string"
        },
        "latency_ms": {
          "default": 0,
          "maximum": 60000,
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "occurrence": {
          "default": 1,
          "maximum": 1000,
          "minimum": 1,
          "title": "Occurrence",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.1",
          "default": "1.1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "action",
        "kind"
      ],
      "title": "FailureSpec",
      "type": "object"
    },
    "JsonValue": {},
    "RefundObjective": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "exclusiveMinimum": 0,
          "title": "Amount",
          "type": "integer"
        },
        "customer_id": {
          "title": "Customer Id",
          "type": "string"
        },
        "duplicate_payment_id": {
          "title": "Duplicate Payment Id",
          "type": "string"
        },
        "kind": {
          "const": "refund_duplicate",
          "default": "refund_duplicate",
          "title": "Kind",
          "type": "string"
        },
        "original_payment_id": {
          "title": "Original Payment Id",
          "type": "string"
        }
      },
      "required": [
        "customer_id",
        "original_payment_id",
        "duplicate_payment_id",
        "amount"
      ],
      "title": "RefundObjective",
      "type": "object"
    },
    "WorldState": {
      "additionalProperties": false,
      "properties": {
        "resources": {
          "additionalProperties": {
            "additionalProperties": {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            "type": "object"
          },
          "title": "Resources",
          "type": "object"
        },
        "step": {
          "default": 0,
          "minimum": 0,
          "title": "Step",
          "type": "integer"
        }
      },
      "title": "WorldState",
      "type": "object"
    }
  },
  "$id": "https://worldforge.local/schemas/scenario-1.1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowed_actions": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Actions",
      "type": "array"
    },
    "failures": {
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/FailureInjection"
          },
          {
            "$ref": "#/$defs/FailureSpec"
          }
        ]
      },
      "maxItems": 32,
      "title": "Failures",
      "type": "array"
    },
    "initial_state": {
      "$ref": "#/$defs/WorldState"
    },
    "max_runtime_seconds": {
      "default": 30.0,
      "exclusiveMinimum": 0,
      "maximum": 3600,
      "title": "Max Runtime Seconds",
      "type": "number"
    },
    "max_steps": {
      "default": 12,
      "maximum": 1000,
      "minimum": 1,
      "title": "Max Steps",
      "type": "integer"
    },
    "objective": {
      "$ref": "#/$defs/RefundObjective"
    },
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "enum": [
        "1.0",
        "1.1"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "simulated_latency_budget_ms": {
      "default": 300000,
      "maximum": 3600000,
      "minimum": 0,
      "title": "Simulated Latency Budget Ms",
      "type": "integer"
    },
    "task": {
      "title": "Task",
      "type": "string"
    },
    "visible": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Visible",
      "type": "object"
    },
    "world_id": {
      "title": "World Id",
      "type": "string"
    },
    "world_version": {
      "default": "1",
      "title": "World Version",
      "type": "string"
    }
  },
  "required": [
    "scenario_id",
    "world_id",
    "seed",
    "task",
    "visible",
    "initial_state",
    "objective",
    "allowed_actions"
  ],
  "title": "Scenario",
  "type": "object"
}
